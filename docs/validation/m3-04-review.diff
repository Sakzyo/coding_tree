+            directories: () => Effect.die("unused"),
+            commit: () => Effect.die("unused"),
+          }),
+        ),
+      ],
+      [
+        LocationServiceMap.node,
+        Layer.effect(
+          LocationServiceMap.Service,
+          LayerMap.make(
+            (_ref: Location.Ref): Layer.Layer<LocationServices> =>
+              Layer.effectContext(Effect.die("execution disabled")),
