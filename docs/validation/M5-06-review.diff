+
+function artifactCopy<A>(schema: Schema.Decoder<A>, value: unknown, code: FtcJava.ArtifactError["code"]) {
+  return Effect.try({
+    try: () => freeze(Schema.decodeUnknownSync(schema, { onExcessProperty: "error" })(structuredClone(value))),
