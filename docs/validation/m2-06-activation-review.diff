+        ),
+      ),
+    )
+  const retain: Interface["retain"] = (lease) =>
+    Effect.suspend(() => {
+      const root = claims.get(lease)
+      if (closed || !root) return Effect.fail(unavailable())
+      return Effect.succeed(publish(root))
+    })
