+    Effect.suspend(() => {
+      const root = folder.canonicalRoot
+      return withRoot(
+        root,
+        Effect.gen(function* () {
+          if (closed || rootState(root).claims.size > 0)
+            return yield* Effect.fail({
+              code: "activation_unavailable",
+              root,
+              recovery: "retry",
+            } satisfies FtcProjects.AssociationError)
+          return yield* commit
+        }),
